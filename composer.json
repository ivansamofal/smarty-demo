{
    "name": "ivansamofal/smarty-demo",
    "description": "Plain PHP blog with categories and posts, rendered with Smarty and backed by MySQL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "smarty/smarty": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "scssphp/scssphp": "^2.1"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration"
    }
}
