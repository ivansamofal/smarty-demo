{
    "name": "ivansamofal/smarty-demo",
    "description": "Plain PHP blog with categories and posts, rendered with Smarty and backed by MySQL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "smarty/smarty": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "require-dev": {
        "scssphp/scssphp": "^2.1"
    }
}
